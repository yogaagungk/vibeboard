{
  "name": "@zanuartri/vibeboard",
  "version": "0.2.2",
  "description": "Self-hostable kanban board with bidirectional MCP integration for AI coding agents",
  "main": "mcp-server/index.js",
  "bin": {
    "vibeboard": "mcp-server/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node mcp-server/index.js",
    "dev": "node --watch mcp-server/index.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "files": [
    "mcp-server/",
    "public/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "kanban",
    "mcp",
    "ai-agents",
    "project-management",
    "self-hosted",
    "claude-code",
    "opencode"
  ],
  "author": "zanuartri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanuartri/vibeboard.git"
  },
  "homepage": "https://github.com/zanuartri/vibeboard#readme",
  "bugs": {
    "url": "https://github.com/zanuartri/vibeboard/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "express": "^4.18.0",
    "zod": "^3.25 || ^4.0"
  }
}
